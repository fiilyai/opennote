{
  "name": "@fiilyai/opennote",
  "version": "0.0.1",
  "description": "用微信收链接、本地织笔记、专题输出的 AI agent。教程项目「10 天学会 AI Agent 开发」配套代码。",
  "type": "module",
  "bin": {
    "opennote": "./dist/bin/opennote.js"
  },
  "files": [
    "dist",
    "opennote.yaml",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx bin/opennote.ts",
    "chat": "tsx bin/opennote.ts chat",
    "build": "tsc",
    "start": "node dist/bin/opennote.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.5",
    "@earendil-works/pi-ai": "0.75.5",
    "@earendil-works/pi-coding-agent": "0.75.5",
    "@earendil-works/pi-tui": "0.75.5",
    "@mozilla/readability": "^0.6.0",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.0",
    "jsdom": "^29.1.1",
    "open": "^11.0.0",
    "qrcode-terminal": "0.12.0",
    "turndown": "^7.2.4",
    "typebox": "1.1.38",
    "yaml": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.7.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "ai",
    "pi",
    "openclaw",
    "wechat",
    "notes",
    "tutorial"
  ],
  "license": "MIT"
}
